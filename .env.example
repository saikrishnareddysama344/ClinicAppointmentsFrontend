# Copy to .env.local to override. All values are optional; defaults are shown.

# Shown in the header and browser tab
VITE_APP_TITLE=BuildWise Admin
VITE_APP_SUBTITLE=Platform console

# Leave empty in development: calls to /v1 go through the Vite proxy below.
# Set it when the API is on another host, e.g. https://api.example.com
VITE_API_BASE_URL=

# Address used in public form links shown to admins (e.g. https://book.example.com).
# Leave empty to use this site's own address.
VITE_PUBLIC_BASE_URL=

# Where the Vite dev server forwards /v1 requests (must match backend API_HOST:API_PORT)
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
VITE_DEV_PORT=5173

# Date formatting locale and how long notifications stay (ms)
VITE_LOCALE=en-IN
VITE_TOAST_LIFE_MS=4000

# Dark mode: system (follow the OS) or off
VITE_DARK_MODE=system
